{
	"name": "@leo-labs-ai/pi-ai",
	"version": "1.5.2",
	"description": "Unified LLM API with automatic model discovery and provider configuration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": [
		"./dist/compat.js",
		"./dist/images.js",
		"./dist/providers/images/register-builtins.js"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./models": {
			"types": "./dist/models.d.ts",
			"import": "./dist/models.js"
		},
		"./compat": {
			"types": "./dist/compat.d.ts",
			"import": "./dist/compat.js"
		},
		"./providers/*": {
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./api/*": {
			"types": "./dist/api/*.d.ts",
			"import": "./dist/api/*.js"
		},
		"./utils/*": {
			"types": "./dist/utils/*.d.ts",
			"import": "./dist/utils/*.js"
		},
		"./oauth": {
			"types": "./dist/oauth.d.ts",
			"import": "./dist/oauth.js"
		},
		"./bedrock-provider": {
			"types": "./dist/bedrock-provider.d.ts",
			"import": "./dist/bedrock-provider.js"
		},
		"./bun-oauth": {
			"types": "./dist/bun-oauth.d.ts",
			"import": "./dist/bun-oauth.js"
		},
		"./lazy-bedrock-provider": {
			"types": "./dist/lazy-bedrock-provider.d.ts",
			"import": "./dist/lazy-bedrock-provider.js"
		},
		"./lazy-oauth": {
			"types": "./dist/lazy-oauth.d.ts",
			"import": "./dist/lazy-oauth.js"
		}
	},
	"bin": {
		"pi-ai": "dist/cli.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"generate-models": "node catalog/generate.ts --strict",
		"hydrate-model-data": "node catalog/generate.ts --strict --data-only",
		"hydrate-model-snapshot": "node scripts/hydrate-model-catalog.ts model-catalog.snapshot.json",
		"refresh-model-snapshot": "node catalog/generate.ts --strict --json-only --json-output ../../.artifacts/model-snapshot --check-api-drift && node scripts/hydrate-model-catalog.ts ../../.artifacts/model-snapshot/models.all.json && cp ../../.artifacts/model-snapshot/models.all.json model-catalog.snapshot.json",
		"generate-model-catalog": "node catalog/generate.ts --strict --json-only --json-output ../../.artifacts/model-catalog",
		"check:model-data": "node scripts/check-model-data.ts",
		"build": "npm run hydrate-model-snapshot && npm run build:offline",
		"build:offline": "npm run check:model-data && tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs clean dist/providers/data && node ../../scripts/package-files.mjs copy src/providers/data dist/providers",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build",
		"generate-image-models": "node scripts/generate-image-models.ts --strict",
		"refresh-models": "npm run generate-models && npm run generate-image-models",
		"prebuild:offline": "npm --prefix ../telemetry run build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.129.0",
		"@aws-sdk/client-bedrock-runtime": "3.1127.0",
		"@earendil-works/pi-schema": "1.5.2",
		"@leo-labs-ai/pi-telemetry": "1.5.2",
		"@google/genai": "2.21.0",
		"@smithy/node-http-handler": "4.12.1",
		"http-proxy-agent": "9.1.0",
		"https-proxy-agent": "9.1.0",
		"openai": "7.19.0",
		"partial-json": "0.1.7"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leo-labs-ai/pi-mono.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"canvas": "3.2.3",
		"typebox": "1.3.27",
		"vitest": "4.1.12"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	}
}
